# Get your token from @BotFather on Telegram, then paste it below.
BOT_TOKEN=your_bot_token_here

# Groq — https://console.groq.com (may be blocked from some cloud IPs)
GROQ_API_KEY=

# Optional: Google AI Studio free key — recommended on Azure if Groq returns 403
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sarvam AI — https://dashboard.sarvam.ai (chat fallback + optional TTS/STT)
SARVAM_API_KEY=

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_SPEAKER=shubh
