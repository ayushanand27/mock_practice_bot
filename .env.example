# Get your token from @BotFather on Telegram, then paste it below.
BOT_TOKEN=your_bot_token_here

# Groq — https://console.groq.com (RAG answers + test generate/grade)
GROQ_API_KEY=

# Sarvam AI — https://dashboard.sarvam.ai (optional TTS/STT)
SARVAM_API_KEY=

# Optional overrides
